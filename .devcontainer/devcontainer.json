{
  "name": "Git Profiles",
  "image": "mcr.microsoft.com/devcontainers/base",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers-extra/features/ruff:2": {
      "version": "0.15.19"
    },
    "ghcr.io/devcontainers-extra/features/ty:1": {
      "version": "0.0.53"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {
      "version": "0.11.24"
    }
  },
  "containerEnv": {
    "UV_CACHE_DIR": ".uv_cache",
    "UV_PYTHON_CACHE_DIR": ".uv_cache"
  },
  "postAttachCommand": "sh .devcontainer/setup.sh"
}
